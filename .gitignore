# The runtime data dir lives at the repo root; anchored so it does not also hide tracked package
# data such as src/s2docs/learning/data/ (the frozen eval set).
/data/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
node_modules/
# CI outputs (scripts/ci/run.sh reports, the uv cache GitLab keeps between jobs)
/ci-reports/
/.cache/
