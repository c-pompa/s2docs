<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Twice-daily s2docs index refresh, so the Build Diff page always has a pair of builds to compare within
  hours of a CS2/Deadlock patch. The equivalent manual command is scripts/sync_index.sh (or
  `.venv/bin/s2docs sync` from the repo root).

  WHY THE PROGRAM IS THE VENV PYTHON BINARY WITH -m, and NOT scripts/sync_index.sh or .venv/bin/s2docs:
  a launchd-spawned /bin/bash cannot read files under /Volumes/SSD_2 (agent exits 126 with
  "bash: /Volumes/.../sync_index.sh: Operation not permitted", and a WorkingDirectory there gives
  "shell-init: error retrieving current directory"). The venv's python is a real Mach-O binary and runs
  fine from that volume — the same pattern ai.hittle.server uses. `.venv/bin/s2docs` is only a shebang
  shim, so it hits the same denial. Hence: python -m s2docs.cli, env passed via EnvironmentVariables.

  Install:
      cp scripts/launchd/com.s2docs.sync.plist ~/Library/LaunchAgents/
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.s2docs.sync.plist
  Run it now and watch the log:
      launchctl kickstart -k gui/$(id -u)/com.s2docs.sync ; tail -f ~/.hermes/logs/s2docs-sync.log
  Change the hours in StartCalendarInterval below; 05:10 / 17:10 avoid the 03:30-04:15 backup window
  and catch a patch the same working day it lands.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.s2docs.sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Volumes/SSD_2/XCode_Repos/myprojects/valve-mcp-api-project/.venv/bin/python</string>
    <string>-m</string>
    <string>s2docs.cli</string>
    <string>sync</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Volumes/SSD_2/XCode_Repos/myprojects/valve-mcp-api-project</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>S2DOCS_DATA_DIR</key>
    <string>/Volumes/SSD_2/XCode_Repos/myprojects/valve-mcp-api-project/data</string>
    <key>HOME</key>
    <string>/Users/christianpompa</string>
    <key>PATH</key>
    <string>/Volumes/SSD_2/XCode_Repos/myprojects/valve-mcp-api-project/.venv/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>5</integer>
      <key>Minute</key>
      <integer>10</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>17</integer>
      <key>Minute</key>
      <integer>10</integer>
    </dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/christianpompa/.hermes/logs/s2docs-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/christianpompa/.hermes/logs/s2docs-sync.log</string>
</dict>
</plist>
