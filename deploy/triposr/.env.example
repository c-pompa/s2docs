# Copy to .env next to docker-compose.yml (never commit .env). The worker refuses to start without it.
# Generate a 64-hex token, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
TSR_API_TOKEN=
